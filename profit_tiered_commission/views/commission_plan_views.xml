<odoo>
    <record id="view_commission_plan_tree" model="ir.ui.view">
        <field name="name">commission.plan.tree</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="tier_method"/>
                <field name="commission_on"/>
                <field name="company_id"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_commission_plan_form" model="ir.ui.view">
        <field name="name">commission.plan.form</field>
        <field name="model">commission.plan</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="company_id"/>
                        <field name="tier_method"/>
                        <field name="commission_on"/>
                        <field name="active"/>
                    </group>
                    <notebook>
                        <page string="Tiers">
                            <field name="tier_line_ids">
                                <list editable="bottom">
                                    <field name="sequence"/>
                                    <field name="from_amount"/>
                                    <field name="to_amount"/>
                                    <field name="rate"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_plan" model="ir.actions.act_window">
        <field name="name">Commission Plans</field>
        <field name="res_model">commission.plan</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_commission_root" name="Sales Commission" sequence="20" groups="profit_tiered_commission.group_commission_user"/>
    <menuitem id="menu_commission_config" name="Configuration" parent="menu_commission_root" sequence="10" groups="profit_tiered_commission.group_commission_manager"/>
    <menuitem id="menu_commission_plan" name="Commission Plans" parent="menu_commission_config" action="action_commission_plan" sequence="10" groups="profit_tiered_commission.group_commission_manager"/>
</odoo>
