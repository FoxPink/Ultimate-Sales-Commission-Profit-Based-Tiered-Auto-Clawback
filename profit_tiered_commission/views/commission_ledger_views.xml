<odoo>
    <record id="view_commission_ledger_tree" model="ir.ui.view">
        <field name="name">commission.ledger.tree</field>
        <field name="model">commission.ledger</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="period_id"/>
                <field name="invoice_date"/>
                <field name="salesperson_id"/>
                <field name="plan_id"/>
                <field name="product_categ_id"/>
                <field name="gross_profit"/>
                <field name="commission_amount"/>
                <field name="state"/>
                <field name="is_clawback"/>
            </list>
        </field>
    </record>

    <record id="view_commission_ledger_search" model="ir.ui.view">
        <field name="name">commission.ledger.search</field>
        <field name="model">commission.ledger</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="period_id"/>
                <field name="salesperson_id"/>
                <field name="product_categ_id"/>
                <field name="invoice_date"/>
                <field name="state"/>
                <filter name="filter_accrued" string="Accrued" domain="[('state','=','accrued')]"/>
                <filter name="filter_payable" string="Payable" domain="[('state','=','payable')]"/>
                <filter name="filter_locked" string="Locked" domain="[('state','=','locked')]"/>
                <filter name="filter_clawback" string="Clawback" domain="[('is_clawback','=',True)]"/>
            </search>
        </field>
    </record>

    <record id="view_commission_ledger_form" model="ir.ui.view">
        <field name="name">commission.ledger.form</field>
        <field name="model">commission.ledger</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_set_payable" string="Set Payable" type="object" invisible="state != 'accrued'" class="btn-primary"/>
                    <button name="action_set_paid" string="Set Paid" type="object" invisible="state != 'payable'" class="btn-primary"/>
                    <button name="action_lock" string="Lock" type="object" invisible="state in ('locked', 'cancel')"/>
                    <button name="action_cancel" string="Cancel" type="object" invisible="state == 'cancel'"/>
                    <button name="action_reset_to_accrued" string="Reset to Accrued" type="object" invisible="state == 'accrued'"/>
                    <field name="state" widget="statusbar" statusbar_visible="accrued,payable,paid,locked,cancel"/>
                </header>
                <sheet>
                    <group>
                        <field name="name" readonly="1"/>
                        <field name="plan_id"/>
                        <field name="period_id"/>
                        <field name="salesperson_id"/>
                        <field name="company_id"/>
                        <field name="is_clawback"/>
                        <field name="origin_ledger_id" invisible="not is_clawback"/>
                    </group>
                    <group>
                        <field name="source_model"/>
                        <field name="source_id"/>
                        <field name="source_move_id"/>
                        <field name="source_line_id"/>
                        <field name="invoice_date"/>
                        <field name="product_categ_id"/>
                        <field name="source_ref" readonly="1"/>
                    </group>
                    <group>
                        <field name="net_sales"/>
                        <field name="cogs"/>
                        <field name="gross_profit"/>
                        <field name="adjustment_amount"/>
                        <field name="commissionable_profit" readonly="1"/>
                        <field name="commission_amount"/>
                    </group>
                    <group>
                        <field name="calculation_key" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_commission_ledger" model="ir.actions.act_window">
        <field name="name">Commission Ledger</field>
        <field name="res_model">commission.ledger</field>
        <field name="view_mode">list,form,pivot,graph</field>
        <field name="search_view_id" ref="view_commission_ledger_search"/>
    </record>

    <record id="view_commission_ledger_pivot" model="ir.ui.view">
        <field name="name">commission.ledger.pivot</field>
        <field name="model">commission.ledger</field>
        <field name="arch" type="xml">
            <pivot string="Commission Analytics">
                <field name="period_id" type="row"/>
                <field name="salesperson_id" type="row"/>
                <field name="product_categ_id" type="col"/>
                <field name="gross_profit" type="measure"/>
                <field name="commission_amount" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_commission_ledger_graph" model="ir.ui.view">
        <field name="name">commission.ledger.graph</field>
        <field name="model">commission.ledger</field>
        <field name="arch" type="xml">
            <graph type="bar" string="Gross Profit vs Commission">
                <field name="period_id"/>
                <field name="gross_profit" type="measure"/>
                <field name="commission_amount" type="measure"/>
            </graph>
        </field>
    </record>

    <menuitem id="menu_commission_ledger" name="Commission Ledger" parent="menu_commission_root" action="action_commission_ledger" sequence="10" groups="profit_tiered_commission.group_commission_user"/>
</odoo>
