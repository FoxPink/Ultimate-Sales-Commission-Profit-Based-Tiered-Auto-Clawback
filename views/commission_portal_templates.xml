<odoo>
    <template id="portal_commission_home" name="Commission Portal Home" inherit_id="portal.portal_my_home" priority="50">
        <xpath expr="//div[contains(@class, 'o_portal_docs')]" position="inside">
            <div class="col-12 col-lg-6 mb-3">
                <div class="card shadow-sm rounded-3 border-0">
                    <div class="card-body">
                        <h5 class="card-title mb-3">Sales Commission</h5>
                        <div class="row g-2">
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-info-subtle">
                                    <div class="text-muted small">Accrued</div>
                                    <div class="fw-semibold">Realtime</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-success-subtle">
                                    <div class="text-muted small">Payable</div>
                                    <div class="fw-semibold">Tracked</div>
                                </div>
                            </div>
                            <div class="col-4">
                                <div class="p-2 rounded-3 bg-danger-subtle">
                                    <div class="text-muted small">Clawback</div>
                                    <div class="fw-semibold">Auditable</div>
                                </div>
                            </div>
                        </div>
                        <div class="mt-3">
                            <a href="/my/commissions" class="btn btn-outline-primary btn-sm">View My Commission Ledger</a>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

    <template id="portal_my_commissions" name="My Commissions">
        <t t-call="portal.portal_layout">
            <div class="container py-4">
                <h3 class="mb-3">My Commissions</h3>
                <div class="row g-3 mb-4">
                    <div class="col-12 col-lg-4">
                        <div class="card shadow-sm rounded-3 border-0 bg-info-subtle">
                            <div class="card-body">
                                <div class="text-muted small">Accrued</div>
                                <div class="fw-semibold fs-5" t-out="amounts['accrued']"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card shadow-sm rounded-3 border-0 bg-success-subtle">
                            <div class="card-body">
                                <div class="text-muted small">Payable</div>
                                <div class="fw-semibold fs-5" t-out="amounts['payable']"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-12 col-lg-4">
                        <div class="card shadow-sm rounded-3 border-0 bg-danger-subtle">
                            <div class="card-body">
                                <div class="text-muted small">Clawback</div>
                                <div class="fw-semibold fs-5" t-out="amounts['clawback']"/>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle">
                        <thead>
                            <tr>
                                <th>Reference</th>
                                <th>Date</th>
                                <th>Gross Profit</th>
                                <th>Commission</th>
                                <th>Status</th>
                                <th>Audit</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-foreach="ledgers" t-as="ledger">
                                <tr>
                                    <td t-out="ledger.name"/>
                                    <td t-out="ledger.invoice_date"/>
                                    <td t-out="ledger.gross_profit"/>
                                    <td t-out="ledger.commission_amount"/>
                                    <td>
                                        <span
                                            class="badge"
                                            t-att-class="'bg-success' if ledger.state in ('payable', 'locked', 'paid') else ('bg-info' if ledger.state == 'accrued' else 'bg-secondary')"
                                            t-out="ledger.state"
                                        />
                                    </td>
                                    <td>
                                        <a
                                            t-if="ledger.source_model == 'account.move' and ledger.source_id"
                                            t-att-href="'/report/pdf/account.account_invoices/%s' % ledger.source_id"
                                            target="_blank"
                                            class="btn btn-outline-secondary btn-sm"
                                        >
                                            PDF
                                        </a>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>
                </div>
            </div>
        </t>
    </template>
</odoo>
